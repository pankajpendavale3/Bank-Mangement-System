pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/pankajpendavale3/bank-management-system.git'
            }
        }

        stage('Build Maven') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t bank-app .'
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                docker stop bank || true
                docker rm bank || true
                docker run -d -p 8080:8080 --name bank bank-app
                '''
            }
        }
    }
}
